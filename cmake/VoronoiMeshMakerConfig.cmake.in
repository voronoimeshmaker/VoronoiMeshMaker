@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

if(POLICY CMP0167)
    cmake_policy(SET CMP0167 NEW)
    set(_VMM_CMAKE_POLICY_DEFAULT_CMP0167 "${CMAKE_POLICY_DEFAULT_CMP0167}")
    set(CMAKE_POLICY_DEFAULT_CMP0167 NEW)
endif()

find_dependency(CGAL @CGAL_VERSION@ EXACT COMPONENTS Core)
include("${CMAKE_CURRENT_LIST_DIR}/VerifyCGALHeaders.cmake")
vmm_verify_cgal_headers()

find_dependency(TBB)

if(POLICY CMP0167)
    set(CMAKE_POLICY_DEFAULT_CMP0167 "${_VMM_CMAKE_POLICY_DEFAULT_CMP0167}")
    unset(_VMM_CMAKE_POLICY_DEFAULT_CMP0167)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/VoronoiMeshMakerTargets.cmake")

check_required_components(VoronoiMeshMaker)
